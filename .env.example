# Database (Supabase, Render Postgres, or local Docker)
DATABASE_URL=postgresql://soc:soc_dev_password@localhost:5432/support_ops

# LLM provider: groq (free, default) or openai
LLM_PROVIDER=groq

# Groq — free API key at https://console.groq.com
GROQ_API_KEY=gsk-your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI — optional paid provider
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL pool tuning (optional)
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=10000

# Enable SSL for managed Postgres (auto-detected for supabase/render URLs)
# DATABASE_SSL=true

# Frontend (only if hosted separately from backend)
# VITE_API_URL=http://localhost:3001/api
